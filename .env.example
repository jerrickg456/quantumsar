# Copy to config.env (git-ignored) and fill in. NEVER commit real values.
# Deployed server, option A (works today): output of scripts/create_deploy_credentials.py
# CLASSIQ_DEPLOY_CREDENTIALS=
# QUANTUMSAR_ALLOW_LIVE_CLASSIQ=1
# QUANTUMSAR_MAX_QUEUE=4             # max queued/running live Classiq jobs
# Deployed server, option B: machine-to-machine Classiq auth (provisioned by Classiq):
CLASSIQ_CLIENT_ID=
CLASSIQ_CLIENT_SECRET=
# CLASSIQ_ORG_ID=
# App behaviour
# QUANTUMSAR_ALLOW_LIVE_CLASSIQ=0   # 1 = run Classiq live when credentials work
# QUANTUMSAR_DISABLE_CLASSIQ=0      # 1 = never try Classiq
# QUANTUMSAR_FALLBACK=qaoa_local    # or "annealing"
# QUANTUMSAR_API_URL=http://localhost:8000
